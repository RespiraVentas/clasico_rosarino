+/* Años del eje: si dos quedan pegados (pasa en celular con las décadas de pocos partidos),
+   se oculta el del medio para que no se lea "20002020". El primero y el último quedan
+   siempre. Se recalcula al cambiar el ancho de la pantalla. */
+function carYrsAjustar(){
+  const sp = $$("#carYrs span"); sp.forEach(s=>s.classList.remove("apr"));
+  const vis = sp.filter(s=>s.offsetWidth); if(vis.length<3) return;
+  const ult = vis[vis.length-1].getBoundingClientRect().left;
+  let der = vis[0].getBoundingClientRect().right;
+  for(let i=1;i<vis.length-1;i++){
+    const r = vis[i].getBoundingClientRect();
+    if(r.left < der+2 || r.right > ult-2){ vis[i].classList.add("apr"); continue; }
+    der = r.right;
+  }
+}
