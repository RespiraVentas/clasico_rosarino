Para llegar a los buscadores con Tab había que pasar antes por todos los botones del
encabezado. El enlace es invisible hasta que se llega con Tab (no cambia el diseño) y
lleva directo al contenido principal.
---
 index.html | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/index.html b/index.html
index 133192c..3f987a0 100644
--- a/index.html
+++ b/index.html
@@ -1114,9 +1114,14 @@ html.pn-on .flot{display:none}
 .ult-r.g-NOB .q1::before{background:var(--nob-raya)}
 .chip[data-k="nob"] .ck{background:var(--nob-raya)}
 .col .s-nob{background:linear-gradient(90deg,var(--nob-rojo) 0 50%,var(--nob-negro) 50% 84%,var(--nob-rojo) 84%)}
+/* Enlace "Saltar al contenido": invisible hasta que se llega con Tab */
+.saltar{position:absolute;left:12px;top:-80px;z-index:300;background:var(--txt);color:var(--bg);padding:12px 18px;border-radius:999px;font-weight:800;text-decoration:none}
+.saltar:focus{top:12px}
+main:focus{outline:none}
 </style>
 </head>
 <body>
+<a class="saltar" href="#contenido">Saltar al contenido</a>
 
 <!-- Barra que aparece cuando hay un filtro activo -->
 <div class="cutbar" id="cutbar">
@@ -1167,7 +1172,7 @@ html.pn-on .flot{display:none}
   </div>
 </header>
 
-<main>
+<main id="contenido" tabindex="-1">
 <section id="buscador" aria-label="Buscador rápido">
   <div class="wrap">
     <p class="bus-t">¿Qué querés buscar?</p>
